# ============================================================
# FastMoveX API — environment variables. Copy to .env and fill in.
# Full reference with production values: ../../ENVIRONMENT.md
# ============================================================

NODE_ENV=development            # development | test | production
PORT=4000

# ---- Database (PostgreSQL 16+, UTF8) ------------------------
DATABASE_URL="postgresql://jovia:jovia@localhost:5432/jovia"
DATABASE_POOL_MAX=10            # connections per API instance
# DATABASE_CA_CERT=             # hosted Postgres (Supabase…): the provider's CA certificate (PEM) → verified TLS

# ---- Auth ----------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900      # 15 min access tokens
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
COOKIE_DOMAIN=                  # production: .fastmovex.qa
DEFAULT_COUNTRY=QA
# Two-step sign-in for staff: required | optional (default: required when NODE_ENV=production)
# STAFF_TWO_FACTOR=optional
# Shared with the website server (apps/web INTERNAL_API_KEY): its page renders skip per-IP rate limits. 32+ random chars.
INTERNAL_API_KEY=

# ---- Encryption of sensitive fields (seller IBANs) -----------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change after go-live (existing IBANs become unreadable). Keep it in a secrets manager.
FIELD_ENCRYPTION_KEY=

# ---- Storage (S3-compatible) — local MinIO from docker-compose
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=jovia
S3_SECRET_ACCESS_KEY=jovia-minio-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PUBLIC=jovia-public      # product images, logos, banners (behind CDN)
S3_BUCKET_PRIVATE=jovia-private    # seller documents, delivery photos (signed URLs only)
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/jovia-public

# ---- Cache ---------------------------------------------------
REDIS_URL=redis://localhost:6379   # optional; empty = in-memory cache (single instance only)

# ---- Finance ---------------------------------------------------
PAYOUT_MIN_MINOR=5000              # smallest payout request, minor units (QAR 50.00)
STOCK_WRITE_OFF_LIMIT_MINOR=50000  # stock value (at cost) one person may write off without a manager (QAR 500.00)

# ---- Notifications ("none" = off, "log" = print to console — development only) ----
NOTIFY_EMAIL_DRIVER=log            # production: resend
RESEND_API_KEY=
EMAIL_FROM="FastMoveX <no-reply@fastmovex.qa>"
NOTIFY_SMS_DRIVER=log              # production: twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_PUSH_DRIVER=log             # FCM driver comes with the mobile app
# WhatsApp order updates (Meta WhatsApp Cloud API). log = print to the console; cloud = send (needs the two keys).
WHATSAPP_DRIVER=log
# WHATSAPP_TOKEN=                   # permanent system-user token from Meta Business settings
# WHATSAPP_PHONE_NUMBER_ID=         # numeric id of the sending number (WhatsApp Manager → API setup)
# Browser notifications for the website (Web Push). Generate once: npx web-push generate-vapid-keys. Empty = off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@fastmovex.qa
# Sign in with Google / Apple (customers). Comma-separated; the website's id first. Empty = no button.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
ADMIN_URL=http://localhost:3002        # admin panel address: links in staff alert emails
STOREFRONT_URL=http://localhost:3000   # website address: tracking links in emails, cart links in reminders, instant website refresh after admin changes
# STOREFRONT_INTERNAL_URL=http://web:3000  # only if the API reaches the website server on another (internal) address

# Card payments (Dibsy, Qatar): cards, Apple Pay, Google Pay, Himyan on Dibsy's hosted page.
# Empty = no gateway (development uses the built-in test sandbox; production offers cash on delivery only).
# To try the real flow locally without a Dibsy account: `npm run dibsy:sandbox`, then uncomment these three lines.
# DIBSY_SECRET_KEY=sk_test_local_sandbox_key
# DIBSY_API_URL=http://localhost:4010/v2
# API_PUBLIC_URL=http://localhost:4000

# ---- Seeding (not read by the running API) --------------------
SEED_SUPERADMIN_EMAIL=             # first super admin, created by `npm run db:seed`
SEED_SUPERADMIN_PASSWORD=          # 12+ chars; change it after the first login
DEMO_PASSWORD=Demo-Pass-2026       # password of the demo accounts (`npm run db:seed:demo`, never in production)
