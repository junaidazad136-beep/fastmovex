# ─── FastMoveX admin panel (apps/admin) ────────────────────────────────────────
# All read at RUNTIME by the server, so one Docker image works in every environment.
# The panel has no secrets: staff sign in with their own account and every call is checked by the API.

# Where browsers call the API (public URL, ends with /api/v1). Add this panel's origin to the API's CORS_ORIGINS.
PUBLIC_API_URL=http://localhost:4000/api/v1
# The customer website, for "View on store" links
STOREFRONT_URL=http://localhost:3000
# Media origin (product photos, banners), allowed in the Content-Security-Policy img-src
MEDIA_URL=http://127.0.0.1:9000
# Market the panel works in by default
DEFAULT_COUNTRY=QA
# Drivers' live map background tiles ({z}/{x}/{y}, optional {s}); its origin is added to the CSP img-src.
# Default: OpenStreetMap's own tiles (fine for a few staff screens). For heavier use, a tile provider URL with its key.
# "none" = pins only, no background map.
MAP_TILE_URL=
MAP_ATTRIBUTION=
