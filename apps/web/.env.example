# ─── FastMoveX website (apps/web) ──────────────────────────────────────────────
# Read at RUNTIME by the server (one Docker image works in every environment):

# Where browsers call the API (public URL, ends with /api/v1)
PUBLIC_API_URL=http://localhost:4000/api/v1
# Where the Next.js server calls the API (private network in production; defaults to PUBLIC_API_URL)
API_INTERNAL_URL=http://localhost:4000/api/v1
# Public address of this website: canonical URLs, sitemap, Open Graph
SITE_URL=http://localhost:3000
# Market shown to visitors (must be an active country in the API)
DEFAULT_COUNTRY=QA
# Same value as INTERNAL_API_KEY in the API (32+ random chars). Lets server-side page renders skip per-IP rate limits,
# and lets the API refresh the website's cache right after staff change something (POST /api/revalidate).
# Server-only: never prefix with NEXT_PUBLIC_.
INTERNAL_API_KEY=
# Media origin for the Content-Security-Policy img-src (defaults to NEXT_PUBLIC_MEDIA_URL)
MEDIA_URL=
# off = take Google's / Apple's sign-in origins out of the Content-Security-Policy (when neither is set up on the API)
# SOCIAL_SIGN_IN=off

# Read at BUILD time (set them as Docker build args):

# Public base URL of product images (the API's PUBLIC_MEDIA_BASE_URL). Enables image optimisation (AVIF/WebP, responsive sizes)
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:9000/jovia-public
# Local development only: allow the image optimiser to fetch from 127.0.0.1 (MinIO). NEVER in a real deployment.
IMAGE_ALLOW_LOCAL_IP=true
# Set to "false" to serve images without optimisation (e.g. when a CDN image service does it)
IMAGE_OPTIMIZATION=true
